<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="DevDesk.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - DevDesk IT Portal</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <form runat="server" class="d-flex flex-column min-vh-100">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold text-white d-flex align-items-center" runat="server" href="~/">
                    <i class="bi bi-shield-check text-warning fs-4 me-2"></i>
                    <span>DevDesk <span class="badge bg-primary text-white fs-6 fw-normal ms-1">IT Portal</span></span>
                </a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#devdeskNavbar" title="Toggle navigation" aria-controls="devdeskNavbar"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="devdeskNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" runat="server" href="~/Default.aspx"><i class="bi bi-house-door me-1"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" runat="server" href="~/Pages/Tickets/List.aspx"><i class="bi bi-ticket-detailed me-1"></i> Tickets</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" runat="server" href="~/Pages/Assets/List.aspx"><i class="bi bi-laptop me-1"></i> Assets</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" runat="server" href="~/Pages/Dashboard/Default.aspx"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <asp:LoginView ID="HeadLoginView" runat="server">
                            <AnonymousTemplate>
                                <a href='<%# ResolveUrl("~/Pages/Auth/Login.aspx") %>' class="btn btn-outline-light btn-sm px-3">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </a>
                                <a href='<%# ResolveUrl("~/Pages/Auth/Register.aspx") %>' class="btn btn-primary btn-sm px-3">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </AnonymousTemplate>
                            <LoggedInTemplate>
                                <span class="navbar-text text-white me-2">
                                    <i class="bi bi-person-circle me-1"></i> Welcome!
                                </span>
                                <a href='<%# ResolveUrl("~/Pages/Auth/Logout.aspx") %>' class="btn btn-outline-danger btn-sm px-3">
                                    <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                                </a>
                            </LoggedInTemplate>
                        </asp:LoginView>
                    </div>
                </div>
            </div>
        </nav>

        <main class="flex-grow-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <footer class="bg-dark text-white-50 py-4 mt-auto border-top border-secondary">
            <div class="container text-center">
                <div class="row align-items-center">
                    <div class="col-md-6 text-md-start mb-2 mb-md-0">
                        <span class="fw-bold text-white"><i class="bi bi-shield-check text-warning me-1"></i> DevDesk</span> - Enterprise Helpdesk & Asset Lifecycle System
                    </div>
                    <div class="col-md-6 text-md-end small">
                        &copy; <%: DateTime.Now.Year %> DevDesk. Built with ASP.NET Web Forms & SQL Server.
                    </div>
                </div>
            </div>
        </footer>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
