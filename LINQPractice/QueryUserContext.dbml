<?xml version="1.0" encoding="utf-8"?><Database Name="AssignmentDB" Class="QueryUserContextDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Function Name="dbo.udp_CreateUser" Method="udp_CreateUser">
    <Parameter Name="UserName" Parameter="userName" Type="System.String" DbType="VarChar(100)" />
    <Parameter Name="Email" Parameter="email" Type="System.String" DbType="VarChar(200)" />
    <Parameter Name="FullName" Parameter="fullName" Type="System.String" DbType="VarChar(200)" />
    <Parameter Name="MobileNo" Parameter="mobileNo" Type="System.String" DbType="VarChar(20)" />
    <Parameter Name="City" Parameter="city" Type="System.String" DbType="VarChar(100)" />
    <Parameter Name="StateName" Parameter="stateName" Type="System.String" DbType="VarChar(100)" />
    <Parameter Name="Country" Parameter="country" Type="System.String" DbType="VarChar(100)" />
    <Parameter Name="Gender" Parameter="gender" Type="System.String" DbType="VarChar(20)" />
    <Parameter Name="QueryText" Parameter="queryText" Type="System.String" DbType="VarChar(MAX)" />
    <Parameter Name="QueryAmount" Parameter="queryAmount" Type="System.Decimal" DbType="Decimal(18,2)" />
    <ElementType Name="udp_CreateUserResult">
      <Column Name="UserId" Type="System.Decimal" DbType="Decimal(38,0)" CanBeNull="true" />
    </ElementType>
  </Function>
  <Function Name="dbo.udp_UpdateUser" Method="udp_UpdateUser">
    <Parameter Name="UserId" Parameter="userId" Type="System.Int32" DbType="Int" />
    <Parameter Name="UserName" Parameter="userName" Type="System.String" DbType="VarChar(100)" />
    <Parameter Name="Email" Parameter="email" Type="System.String" DbType="VarChar(200)" />
    <Parameter Name="FullName" Parameter="fullName" Type="System.String" DbType="VarChar(200)" />
    <Parameter Name="MobileNo" Parameter="mobileNo" Type="System.String" DbType="VarChar(20)" />
    <Parameter Name="City" Parameter="city" Type="System.String" DbType="VarChar(100)" />
    <Parameter Name="StateName" Parameter="stateName" Type="System.String" DbType="VarChar(100)" />
    <Parameter Name="Country" Parameter="country" Type="System.String" DbType="VarChar(100)" />
    <Parameter Name="Gender" Parameter="gender" Type="System.String" DbType="VarChar(20)" />
    <Parameter Name="QueryText" Parameter="queryText" Type="System.String" DbType="VarChar(MAX)" />
    <Parameter Name="IsActive" Parameter="isActive" Type="System.Boolean" DbType="Bit" />
    <Parameter Name="QueryAmount" Parameter="queryAmount" Type="System.Decimal" DbType="Decimal(18,2)" />
    <ElementType Name="udp_UpdateUserResult">
      <Column Name="RowsAffected" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
    </ElementType>
  </Function>
  <Function Name="dbo.udp_GetUserById" Method="udp_GetUserById">
    <Parameter Name="userId" Type="System.Int32" DbType="Int" />
