@{
    ViewBag.Title = "Unauthorized Access";
}

<div class="container mt-5">
    <div class="card border-danger shadow">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Access Denied</h3>
        </div>
        <div class="card-body p-4 text-center">
            <h1 class="text-danger display-4 mb-3">Unauthorized Access</h1>
            <h4 class="text-danger mb-4">You don't have permission to view this page.</h4>
            <p class="text-muted">
                Your account does not possess the required role permissions to access this action.
            </p>
            <div class="mt-4">
                @Html.ActionLink("Go Back to Home", "Index", "Home", null, new { @class = "btn btn-primary" })
                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { @class = "d-inline ms-2" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Log Out &amp; Switch Account</button>
                }
            </div>
        </div>
    </div>
</div>
