@model IEnumerable<MVCPracticeProject.Models.Patient>

@{
    ViewBag.Title = "Patients";
}

<h2>Patients List</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["Message"]
    </div>
}

<p>
    @Html.ActionLink("Create New Patient", "Create", null, new { @class = "btn btn-primary" })
</p>
<table class="table table-bordered table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.PatientId)</th>
            <th>Name</th>
            <th>@Html.DisplayNameFor(model => model.Gender)</th>
            <th>@Html.DisplayNameFor(model => model.Age)</th>
            <th>@Html.DisplayNameFor(model => model.BloodGroup)</th>
            <th>@Html.DisplayNameFor(model => model.DoctorId)</th>
            <th>@Html.DisplayNameFor(model => model.Disease)</th>
            <th>@Html.DisplayNameFor(model => model.AdmissionDate)</th>
            <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.PatientId</td>
                    <td>@(item.FirstName + " " + item.LastName)</td>
                    <td>@item.Gender</td>
                    <td>@item.Age</td>
                    <td>@item.BloodGroup</td>
                    <td>@item.DoctorId</td>
                    <td>@item.Disease</td>
                    <td>@item.AdmissionDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.PhoneNumber</td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.PatientId }, new { @class = "btn btn-sm btn-warning" })
                        @Html.ActionLink("Details", "Details", new { id = item.PatientId }, new { @class = "btn btn-sm btn-info" })
                        @Html.ActionLink("Delete", "Delete", new { id = item.PatientId }, new { @class = "btn btn-sm btn-danger" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10" class="text-center text-muted">No patients found.</td>
            </tr>
        }
    </tbody>
</table>
