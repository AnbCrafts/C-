@model MVCPracticeProject.ViewModels.DoctorPatientViewModel

@{
    ViewBag.Title = "Doctor Details & Assigned Patients";
}

<div class="container mt-4">
    <h2>Doctor & Assigned Patients Details</h2>
    <hr />

    @if (Model.Doctor != null)
    {
        <div class="card mb-4 shadow-sm border-primary">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Dr. @Model.Doctor.FirstName @Model.Doctor.LastName (Doctor ID: @Model.Doctor.DoctorId)</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Specialization:</strong> @Model.Doctor.Specialization</p>
                        <p><strong>Department ID:</strong> @Model.Doctor.DepartmentId</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Email:</strong> @Model.Doctor.Email</p>
                        <p><strong>Phone:</strong> @Model.Doctor.PhoneNumber</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Assigned Patients (@(Model.Patients != null ? Model.Patients.Count : 0))</h4>
        </div>
        <div class="card-body p-0">
            <table class="table table-bordered table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Patient ID</th>
                        <th>Name</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>Blood Group</th>
                        <th>Disease</th>
                        <th>Admission Date</th>
                        <th>Phone</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Patients != null && Model.Patients.Any())
                    {
                        foreach (var patient in Model.Patients)
                        {
                            <tr>
                                <td>@patient.PatientId</td>
                                <td>@patient.FirstName @patient.LastName</td>
                                <td>@patient.Gender</td>
                                <td>@patient.Age</td>
                                <td>@patient.BloodGroup</td>
                                <td>@patient.Disease</td>
                                <td>@patient.AdmissionDate.ToString("yyyy-MM-dd")</td>
                                <td>@patient.PhoneNumber</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted p-3">No patients assigned to this doctor.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        @if (Model.Doctor != null)
        {
            @Html.ActionLink("Edit Doctor", "Edit", new { id = Model.Doctor.DoctorId }, new { @class = "btn btn-warning" })
            @Html.ActionLink("Delete Doctor", "Delete", new { id = Model.Doctor.DoctorId }, new { @class = "btn btn-danger ms-2" })
        }
        @Html.ActionLink("Back to All Doctors & Patients", "Index", null, new { @class = "btn btn-secondary ms-2" })
    </div>
</div>
