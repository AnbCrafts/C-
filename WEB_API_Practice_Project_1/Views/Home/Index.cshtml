@{
    ViewBag.Title = "User Queries Management Dashboard";
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1 text-primary">User Queries Management Portal</h2>
            <p class="text-muted mb-0">REST Web API Practice Project 1 &bull; 3-Layer Architecture (BEL / DAL / BLL)</p>
        </div>
        <div>
            <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-database"></i> Connected: AssignmentDB (labTest.QueryUser)</span>
            <a href="/swagger" target="_blank" class="btn btn-outline-dark btn-sm ms-2">Open Swagger UI &raquo;</a>
        </div>
    </div>

    <!-- Alert / Feedback Notification Banner -->
    <div id="alertBox" class="alert d-none alert-dismissible fade show shadow-sm" role="alert">
        <span id="alertMessage"></span>
        <button type="button" class="btn-close" onclick="hideAlert()" aria-label="Close"></button>
    </div>

    <!-- Top Row: Interactive Operation Cards -->
    <div class="row g-4 mb-4">
        <!-- Card 1: GET User by ID -->
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                    <span class="fw-semibold">Get User By ID</span>
                    <span class="badge bg-light text-primary">GET /api/users/list/{id}</span>
                </div>
                <div class="card-body">
                    <div class="input-group mb-3">
                        <span class="input-group-text">User ID</span>
                        <input type="number" id="searchUserId" class="form-control" placeholder="e.g. 1015, 1016" min="1" />
                        <button class="btn btn-primary" type="button" onclick="fetchUserById()">Fetch</button>
                    </div>

                    <!-- Single User Result Display -->
                    <div id="singleUserResult" class="p-3 bg-light rounded border d-none">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 id="suFullName" class="text-primary mb-0 fw-bold"></h5>
                                <small id="suUserName" class="text-muted"></small>
                            </div>
                            <span id="suId" class="badge bg-secondary"></span>
                        </div>
                        <p class="mb-1"><strong>Email:</strong> <span id="suEmail"></span></p>
                        <p class="mb-1"><strong>Mobile:</strong> <span id="suMobile"></span></p>
                        <p class="mb-1"><strong>Location:</strong> <span id="suLocation"></span></p>
                        <p class="mb-1"><strong>Gender:</strong> <span id="suGender"></span></p>
                        <p class="mb-1"><strong>Query Text:</strong> <span id="suQueryText" class="fst-italic text-dark"></span></p>
                        <p class="mb-0"><strong>Amount:</strong> <span id="suAmount" class="badge bg-success"></span></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: POST Create User -->
        <div class="col-lg-5 col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-3">
                    <span class="fw-semibold">Add New Query User</span>
                    <span class="badge bg-light text-success">POST /api/users/create</span>
                </div>
                <div class="card-body">
                    <form id="createUserForm" onsubmit="event.preventDefault(); createUser();">
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small mb-1 fw-bold">User Name *</label>
                                <input type="text" id="addUserName" class="form-control form-control-sm" required placeholder="anubhaw99" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-1 fw-bold">Email *</label>
                                <input type="email" id="addEmail" class="form-control form-control-sm" required placeholder="user@gmail.com" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-7">
                                <label class="form-label small mb-1 fw-bold">Full Name</label>
                                <input type="text" id="addFullName" class="form-control form-control-sm" placeholder="Anubhaw Gupta" />
                            </div>
                            <div class="col-5">
                                <label class="form-label small mb-1">Mobile No</label>
                                <input type="text" id="addMobile" class="form-control form-control-sm" placeholder="9800000099" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <label class="form-label small mb-1">City</label>
                                <input type="text" id="addCity" class="form-control form-control-sm" placeholder="Delhi" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small mb-1">State</label>
                                <input type="text" id="addState" class="form-control form-control-sm" placeholder="Delhi" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small mb-1">Gender</label>
                                <select id="addGender" class="form-select form-select-sm">
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-8">
                                <label class="form-label small mb-1">Query / Issue</label>
                                <input type="text" id="addQueryText" class="form-control form-control-sm" placeholder="Need assistance with portal..." />
                            </div>
                            <div class="col-4">
                                <label class="form-label small mb-1">Amount (&#8377;)</label>
                                <input type="number" step="0.01" id="addAmount" class="form-control form-control-sm" placeholder="5000.00" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success btn-sm w-100 fw-bold mt-1">Save User to Database</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Card 3: Delete Action -->
        <div class="col-lg-3 col-md-12">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center py-3">
                    <span class="fw-semibold">Delete User</span>
                    <span class="badge bg-light text-danger">DELETE /api/users/delete/{id}</span>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold mb-1">Enter User ID to Delete:</label>
                        <div class="input-group">
                            <input type="number" id="deleteUserId" class="form-control form-control-sm" placeholder="User ID" min="1" />
                            <button class="btn btn-danger btn-sm" type="button" onclick="deleteUserById()">Delete</button>
                        </div>
                    </div>
                    <div class="alert alert-light border py-2 small text-muted mb-0">
                        <i class="bi bi-shield-check text-success"></i> <strong>Safe to delete:</strong> <code>labTest.QueryUser</code> has <strong>no foreign keys</strong>. Deleting will succeed cleanly without constraint blocks!
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table: GET /api/users/list -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
            <div>
                <h5 class="mb-0 fw-bold">All Query Users Directory</h5>
                <small class="text-muted">Directly loaded from <code>GET /api/users/list</code></small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <input type="text" id="tableFilter" class="form-control form-control-sm" style="width: 250px;" placeholder="Filter by name / city / email..." onkeyup="filterTable()" />
                <button class="btn btn-outline-primary btn-sm" type="button" onclick="loadAllUsers()">
                    &circlearrowright; Refresh List
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0" id="usersTable">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 80px;">User ID</th>
                            <th>Username</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>City / State</th>
                            <th>Gender</th>
                            <th>Query Text</th>
                            <th style="width: 100px;">Amount</th>
                            <th style="width: 140px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody">
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                Loading users data from API...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Update User (PUT /api/users/update/{id}) -->
<div class="modal fade" id="updateUserModal" tabindex="-1" aria-labelledby="updateUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold" id="updateUserModalLabel">Edit Query User Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="updateUserForm" onsubmit="event.preventDefault(); submitUserUpdate();">
                    <input type="hidden" id="editUserId" />
                    <div class="mb-2">
                        <label class="form-label small fw-bold">User ID</label>
                        <input type="text" id="displayEditId" class="form-control form-control-sm bg-light" disabled />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-bold">User Name *</label>
                            <input type="text" id="editUserName" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Email *</label>
                            <input type="email" id="editEmail" class="form-control form-control-sm" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-7">
                            <label class="form-label small fw-bold">Full Name</label>
                            <input type="text" id="editFullName" class="form-control form-control-sm" />
                        </div>
                        <div class="col-5">
                            <label class="form-label small">Mobile No</label>
                            <input type="text" id="editMobile" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <label class="form-label small">City</label>
                            <input type="text" id="editCity" class="form-control form-control-sm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">State</label>
                            <input type="text" id="editState" class="form-control form-control-sm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Gender</label>
                            <select id="editGender" class="form-select form-select-sm">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-8">
                            <label class="form-label small">Query Text</label>
                            <input type="text" id="editQueryText" class="form-control form-control-sm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Amount (&#8377;)</label>
                            <input type="number" step="0.01" id="editAmount" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="editIsActive" checked />
                        <label class="form-check-label small" for="editIsActive">Active User</label>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning btn-sm fw-bold">Save Changes (PUT)</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    var usersData = [];
    var updateModalInstance = null;

    // Robust case-insensitive property helper
    function getProp(obj, propName) {
        if (!obj) return '';
        var lower = propName.charAt(0).toLowerCase() + propName.slice(1);
        var upper = propName.charAt(0).toUpperCase() + propName.slice(1);
        if (obj[lower] !== undefined && obj[lower] !== null) return obj[lower];
        if (obj[upper] !== undefined && obj[upper] !== null) return obj[upper];
        return '';
    }

    document.addEventListener("DOMContentLoaded", function () {
        loadAllUsers();
        var modalEl = document.getElementById('updateUserModal');
        if (modalEl && typeof bootstrap !== 'undefined') {
            updateModalInstance = new bootstrap.Modal(modalEl);
        }
    });

    function showAlert(type, message) {
        var alertBox = document.getElementById("alertBox");
        var alertMessage = document.getElementById("alertMessage");
        alertBox.className = "alert alert-dismissible fade show shadow-sm alert-" + type;
        alertMessage.innerHTML = message;
        alertBox.classList.remove("d-none");
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function hideAlert() {
        document.getElementById("alertBox").classList.add("d-none");
    }

    // 1. GET ALL USERS: /api/users/list
    function loadAllUsers() {
        var tbody = document.getElementById("usersTableBody");
        tbody.innerHTML = '<tr><td colspan="10" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Loading users data from API...</td></tr>';

        fetch('/api/users/list')
            .then(function (res) {
                if (!res.ok) throw new Error("HTTP error " + res.status);
                return res.json();
            })
            .then(function (data) {
                usersData = data || [];
                renderTable(usersData);
            })
            .catch(function (err) {
                tbody.innerHTML = '<tr><td colspan="10" class="text-center py-4 text-danger">Failed to load users: ' + err.message + '</td></tr>';
                showAlert("danger", "Failed to load users: " + err.message);
            });
    }

    function renderTable(list) {
        var tbody = document.getElementById("usersTableBody");
        if (!list || list.length === 0) {
            tbody.innerHTML = '<tr><td colspan="10" class="text-center py-4 text-muted">No users found in database.</td></tr>';
            return;
        }

        var html = '';
        list.forEach(function (u) {
            var userId = getProp(u, 'userId');
            var userName = getProp(u, 'userName');
            var fullName = getProp(u, 'fullName');
            var email = getProp(u, 'email');
            var mobileNo = getProp(u, 'mobileNo');
            var city = getProp(u, 'city');
            var stateName = getProp(u, 'stateName');
            var gender = getProp(u, 'gender');
            var queryText = getProp(u, 'queryText');
            var rawAmount = getProp(u, 'queryAmount');

            var amountText = (rawAmount !== '' && rawAmount !== null && rawAmount !== undefined) ? ('&#8377;' + Number(rawAmount).toFixed(2)) : '<span class="text-muted">-</span>';
            var locationText = [city, stateName].filter(Boolean).join(', ') || '-';

            html += '<tr>' +
                '<td><span class="badge bg-secondary fs-6">' + userId + '</span></td>' +
                '<td class="fw-semibold text-primary">' + escapeHtml(userName) + '</td>' +
                '<td>' + escapeHtml(fullName || '-') + '</td>' +
                '<td><a href="mailto:' + escapeHtml(email) + '" class="text-decoration-none">' + escapeHtml(email || '-') + '</a></td>' +
                '<td>' + escapeHtml(mobileNo || '-') + '</td>' +
                '<td>' + escapeHtml(locationText) + '</td>' +
                '<td><span class="badge bg-light text-dark border">' + escapeHtml(gender || '-') + '</span></td>' +
                '<td style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="' + escapeHtml(queryText) + '">' + escapeHtml(queryText || '-') + '</td>' +
                '<td class="fw-bold text-success">' + amountText + '</td>' +
                '<td class="text-center">' +
                    '<button class="btn btn-sm btn-outline-info me-1 py-0 px-2" title="View details" onclick="selectUser(' + userId + ')">View</button>' +
                    '<button class="btn btn-sm btn-outline-warning me-1 py-0 px-2" title="Edit user" onclick="openEditModal(' + userId + ')">Edit</button>' +
                    '<button class="btn btn-sm btn-outline-danger py-0 px-2" title="Delete user" onclick="confirmDelete(' + userId + ')">Del</button>' +
                '</td>' +
            '</tr>';
        });
        tbody.innerHTML = html;
    }

    function filterTable() {
        var q = document.getElementById("tableFilter").value.toLowerCase();
        var filtered = usersData.filter(function (u) {
            var uname = (getProp(u, 'userName') || '').toLowerCase();
            var fname = (getProp(u, 'fullName') || '').toLowerCase();
            var eml = (getProp(u, 'email') || '').toLowerCase();
            var cty = (getProp(u, 'city') || '').toLowerCase();
            var uid = (getProp(u, 'userId') || '').toString();
            return uname.includes(q) || fname.includes(q) || eml.includes(q) || cty.includes(q) || uid.includes(q);
        });
        renderTable(filtered);
    }

    // 2. GET USER BY ID: /api/users/list/{id}
    function fetchUserById() {
        var id = document.getElementById("searchUserId").value.trim();
        if (!id) {
            showAlert("warning", "Please enter a valid User ID to fetch.");
            return;
        }

        fetch('/api/users/list/' + id)
            .then(function (res) {
                if (res.status === 404) {
                    throw new Error("User with ID " + id + " was not found.");
                }
                if (!res.ok) throw new Error("HTTP error " + res.status);
                return res.json();
            })
            .then(function (u) {
                var uid = getProp(u, 'userId');
                var uname = getProp(u, 'userName');
                var fname = getProp(u, 'fullName');
                var eml = getProp(u, 'email');
                var mob = getProp(u, 'mobileNo');
                var cty = getProp(u, 'city');
                var st = getProp(u, 'stateName');
                var ctry = getProp(u, 'country');
                var gen = getProp(u, 'gender');
                var qtext = getProp(u, 'queryText');
                var amt = getProp(u, 'queryAmount');

                document.getElementById("suFullName").innerText = fname || uname || 'User';
                document.getElementById("suUserName").innerText = uname ? ("User: " + uname) : '';
                document.getElementById("suId").innerText = 'ID: ' + uid;
                document.getElementById("suEmail").innerText = eml || 'N/A';
                document.getElementById("suMobile").innerText = mob || 'N/A';
                document.getElementById("suLocation").innerText = [cty, st, ctry].filter(Boolean).join(', ') || 'N/A';
                document.getElementById("suGender").innerText = gen || 'N/A';
                document.getElementById("suQueryText").innerText = qtext || 'None';
                document.getElementById("suAmount").innerText = (amt !== '' && amt !== null && amt !== undefined) ? ('₹' + Number(amt).toFixed(2)) : 'N/A';

                var box = document.getElementById("singleUserResult");
                box.classList.remove("d-none");
                showAlert("success", "Found user: <strong>" + (fname || uname) + "</strong> (ID: " + uid + ")");
            })
            .catch(function (err) {
                document.getElementById("singleUserResult").classList.add("d-none");
                showAlert("danger", err.message);
            });
    }

    function selectUser(id) {
        document.getElementById("searchUserId").value = id;
        fetchUserById();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // 3. POST CREATE USER: /api/users/create
    function createUser() {
        var payload = {
            UserName: document.getElementById("addUserName").value.trim(),
            Email: document.getElementById("addEmail").value.trim(),
            FullName: document.getElementById("addFullName").value.trim() || null,
            MobileNo: document.getElementById("addMobile").value.trim() || null,
            City: document.getElementById("addCity").value.trim() || null,
            StateName: document.getElementById("addState").value.trim() || null,
            Country: "India",
            Gender: document.getElementById("addGender").value,
            QueryText: document.getElementById("addQueryText").value.trim() || null,
            QueryAmount: document.getElementById("addAmount").value ? parseFloat(document.getElementById("addAmount").value) : null,
            IsActive: true
        };

        fetch('/api/users/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(function (res) {
            return res.json().then(function (data) {
                if (!res.ok) throw new Error(data.message || ("HTTP Error " + res.status));
                return data;
            });
        })
        .then(function (data) {
            showAlert("success", data.message || "User created successfully!");
            document.getElementById("createUserForm").reset();
            loadAllUsers();
        })
        .catch(function (err) {
            showAlert("danger", "Failed to create user: " + err.message);
        });
    }

    // 4. PUT UPDATE USER: /api/users/update/{id}
    function openEditModal(id) {
        var user = usersData.find(function (u) { return getProp(u, 'userId') == id; });
        if (!user) {
            fetch('/api/users/list/' + id)
                .then(function (res) { return res.json(); })
                .then(function (u) { populateEditModal(u); })
                .catch(function (err) { showAlert("danger", "Cannot load user: " + err.message); });
        } else {
            populateEditModal(user);
        }
    }

    function populateEditModal(u) {
        var uid = getProp(u, 'userId');
        document.getElementById("editUserId").value = uid;
        document.getElementById("displayEditId").value = uid;
        document.getElementById("editUserName").value = getProp(u, 'userName');
        document.getElementById("editEmail").value = getProp(u, 'email');
        document.getElementById("editFullName").value = getProp(u, 'fullName');
        document.getElementById("editMobile").value = getProp(u, 'mobileNo');
        document.getElementById("editCity").value = getProp(u, 'city');
        document.getElementById("editState").value = getProp(u, 'stateName');
        document.getElementById("editGender").value = getProp(u, 'gender') || 'Male';
        document.getElementById("editQueryText").value = getProp(u, 'queryText');
        var amt = getProp(u, 'queryAmount');
        document.getElementById("editAmount").value = (amt !== '' && amt !== null && amt !== undefined) ? amt : '';
        document.getElementById("editIsActive").checked = getProp(u, 'isActive') !== false;

        if (!updateModalInstance) {
            updateModalInstance = new bootstrap.Modal(document.getElementById('updateUserModal'));
        }
        updateModalInstance.show();
    }

    function submitUserUpdate() {
        var id = document.getElementById("editUserId").value;
        var payload = {
            UserId: parseInt(id),
            UserName: document.getElementById("editUserName").value.trim(),
            Email: document.getElementById("editEmail").value.trim(),
            FullName: document.getElementById("editFullName").value.trim() || null,
            MobileNo: document.getElementById("editMobile").value.trim() || null,
            City: document.getElementById("editCity").value.trim() || null,
            StateName: document.getElementById("editState").value.trim() || null,
            Country: "India",
            Gender: document.getElementById("editGender").value,
            QueryText: document.getElementById("editQueryText").value.trim() || null,
            QueryAmount: document.getElementById("editAmount").value ? parseFloat(document.getElementById("editAmount").value) : null,
            IsActive: document.getElementById("editIsActive").checked
        };

        fetch('/api/users/update/' + id, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(function (res) {
            return res.json().then(function (data) {
                if (!res.ok) throw new Error(data.message || ("HTTP Error " + res.status));
                return data;
            });
        })
        .then(function (data) {
            if (updateModalInstance) updateModalInstance.hide();
            showAlert("success", data.message || "User updated successfully!");
            loadAllUsers();
        })
        .catch(function (err) {
            showAlert("danger", "Failed to update user: " + err.message);
        });
    }

    // 5. DELETE USER: /api/users/delete/{id}
    function deleteUserById() {
        var id = document.getElementById("deleteUserId").value.trim();
        if (!id) {
            showAlert("warning", "Please enter a valid User ID to delete.");
            return;
        }
        confirmDelete(id);
    }

    function confirmDelete(id) {
        if (!confirm("Are you sure you want to delete User with ID " + id + "?")) {
            return;
        }

        fetch('/api/users/delete/' + id, {
            method: 'DELETE'
        })
        .then(function (res) {
            return res.json().then(function (data) {
                if (!res.ok) throw new Error(data.message || ("HTTP Error " + res.status));
                return data;
            });
        })
        .then(function (data) {
            showAlert("success", data.message || "User deleted successfully!");
            document.getElementById("deleteUserId").value = '';
            var suId = document.getElementById("suId").innerText;
            if (suId.includes(id)) {
                document.getElementById("singleUserResult").classList.add("d-none");
            }
            loadAllUsers();
        })
        .catch(function (err) {
            showAlert("danger", "Failed to delete: " + err.message);
        });
    }

    function escapeHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }
</script>
}
