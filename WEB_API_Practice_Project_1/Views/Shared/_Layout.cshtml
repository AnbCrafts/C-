<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - User Queries API</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        .card {
            border-radius: 8px;
        }
        .card-header {
            border-top-left-radius: 8px !important;
            border-top-right-radius: 8px !important;
        }
        .table > tbody > tr:hover {
            background-color: #f1f5f9;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand text-white" href="/">
                <i class="bi bi-people-fill text-info me-2"></i>User Queries Portal
            </a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#mainNavbar" title="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="/"><i class="bi bi-speedometer2 me-1"></i> Dashboard UI</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/swagger" target="_blank"><i class="bi bi-file-earmark-code me-1"></i> Swagger API Docs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Help"><i class="bi bi-question-circle me-1"></i> Help Page</a>
                    </li>
                </ul>
                <div class="d-flex text-light small align-items-center">
                    <span class="badge bg-secondary me-2">3-Layer Arch</span>
                    <span>REST Web API</span>
                </div>
            </div>
        </div>
    </nav>

    <div class="container body-content mt-3">
        @RenderBody()
        <hr class="mt-5" />
        <footer class="text-muted small py-3 d-flex justify-content-between">
            <div>&copy; @DateTime.Now.Year - Web API Practice Project 1 &bull; <code>AssignmentDB.[labTest].[QueryUser]</code></div>
            <div>Built with ASP.NET Web API 2 + ADO.NET + Bootstrap 5</div>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
