<%@ Master Language="C#"
    AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="URLRouting.SiteMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>

    <asp:ContentPlaceHolder ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

    <style>

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f6f9;
        }

        .header {
            background-color: #0078d7;
            color: white;
            padding: 20px;
        }

        .header h1 {
            margin: 0;
        }

        .search-panel {
            padding: 15px;
            background-color: white;
            box-shadow: 0 2px 8px rgba(0,0,0,.1);
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .search-box {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            width: 220px;
        }

        .btn {
            padding: 10px 16px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            color: white;
            background-color: #0078d7;
        }

        .main {
            padding: 20px;
        }

    </style>

</head>

<body>

<form id="form1" runat="server">

    <div class="header">
        <h1>User Management Portal</h1>
    </div>

    <asp:Panel ID="panelSearch"
        runat="server"
        CssClass="search-panel">

        <asp:TextBox ID="txtUsername"
            runat="server"
            CssClass="search-box"
            placeholder="Username">
        </asp:TextBox>

        <asp:TextBox ID="txtEmail"
            runat="server"
            CssClass="search-box"
            placeholder="Email">
        </asp:TextBox>

        <asp:Button ID="btnSearch"
            runat="server"
            Text="Search"
            CssClass="btn" />

    </asp:Panel>

    <div class="main">

        <asp:ContentPlaceHolder
            ID="MainContent"
            runat="server">
        </asp:ContentPlaceHolder>

    </div>

</form>

</body>
</html>